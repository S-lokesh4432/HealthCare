DATABASE_URL=              # Neon pooled connection string
DIRECT_URL=                # Neon direct connection string (for migrations)

PORT=4000
CORS_ORIGIN=http://localhost:5500   # your frontend's dev origin(s), comma-separated

JWT_SECRET=                # long random string, e.g. `openssl rand -hex 32`
JWT_EXPIRES_IN=24h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GEMINI_API_KEY=
XAI_API_KEY=            # xAI Grok, fallback LLM

RESEND_API_KEY=
EMAIL_FROM=

CRON_SECRET=
ENCRYPTION_KEY=             # 32-byte hex, for calendar token encryption: openssl rand -hex 32

APP_BASE_URL=http://localhost:4000
